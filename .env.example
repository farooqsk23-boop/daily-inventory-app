# Claude API key for reading handwritten count sheets and delivery notes.
# Without it the app still works; counts and deliveries are typed in.
ANTHROPIC_API_KEY=
# Optional: override the vision model (default claude-opus-5-5).
# OCR_MODEL=claude-opus-5-5

# Optional PIN to lock the app when it is reachable from the internet.
APP_PIN=

PORT=3000
# Where the SQLite database and uploaded photos are kept (default ./data).
# DATA_DIR=/var/lib/stockroom
# Contact for Web Push (VAPID). Any mailto: works.
# VAPID_SUBJECT=mailto:you@example.com
