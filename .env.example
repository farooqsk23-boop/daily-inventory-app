# Copy to .env; the server loads it on start (Windows, macOS and Linux).

# AI scan keys. Optional: they can also be pasted in the app under Settings -> AI scan.
# Claude (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Google Gemini (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Starting provider until one is chosen in Settings: claude or gemini
# OCR_PROVIDER=claude
# Optional model overrides
# OCR_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-flash-latest

# Optional PIN to lock the app when it is reachable from the internet.
APP_PIN=

PORT=3000
# Where the SQLite database and uploaded photos are kept (default ./data).
# DATA_DIR=/var/lib/stockroom
# Contact for Web Push (VAPID). Any mailto: works.
# VAPID_SUBJECT=mailto:you@example.com
